{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cron": "3.5.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-jwt": "8.5.1",
    "jwks-rsa": "3.1.0",
    "lodash": "4.17.21",
    "moment-timezone": "0.5.47",
    "mongoose": "8.10.0",
    "path": "0.12.7",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "nodemon": "3.1.9"
  },
  "engines": {
    "node": "20.10.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/server",
    "prod-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/workers",
    "client": "nodemon start-client.js",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "npm install vite && cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
