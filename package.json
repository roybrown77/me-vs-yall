{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron": "4.4.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-jwt": "8.5.1",
    "jwks-rsa": "4.1.0",
    "lodash": "4.18.1",
    "moment-timezone": "0.6.5",
    "mongoose": "9.11.2",
    "path": "0.12.7",
    "puppeteer": "^25.14.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "nodemon": "3.1.14"
  },
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix src/client",
    "start": "concurrently --kill-others --handle-input \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "backup:mongo": "node src/server/scripts/backupMongoToFiles.js",
    "backup-since-last:mongo": "node src/server/scripts/backupSinceLastMongoToFiles.js",
    "prod-server": "node src/server",
    "prod-worker": "node src/workers",
    "test": "find src/server -path '*/__tests__/*.test.js' -print0 | xargs -0 node --test",
    "test:race-budget": "npm --prefix src/client run test:race-budget",
    "check:race-budget": "npm --prefix src/client run check:race-budget",
    "test:notification": "npm test",
    "client": "nodemon start-client.js",
    "generate-vapid": "npx web-push generate-vapid-keys",
    "local-prod": "npm --prefix src/client run build && NODE_ENV=production node src/server",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "npm test && npm run check:race-budget && bash scripts/herokuClientBuild.sh"
  }
}
