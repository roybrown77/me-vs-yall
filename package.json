{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "amqp-connection-manager": "3.2.1",
    "amqplib": "0.6.0",
    "body-parser": "1.19.0",
    "cron": "1.8.2",
    "dotenv": "8.2.0",
    "express": "4.17.1",
    "express-jwt": "6.0.0",
    "jwks-rsa": "1.12.2",
    "lodash": "4.17.20",
    "moment-timezone": "0.5.32",
    "mongoose": "5.11.13",
    "path": "0.12.7",
    "puppeteer": "5.5.0"
  },
  "devDependencies": {
    "concurrently": "5.3.0",
    "nodemon": "2.0.7"
  },
  "cacheDirectories": [
    "node_modules",
    "src/client/node_modules",
    "src/client/src/styles"
  ],
  "engines": {
    "node": "14.x"
  },
  "scripts": {
    "start_local": "concurrently \"npm run local-server\" \"npm run client\"",
    "local-server": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config src/server",
    "local-clock": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config clock.js",
    "local-worker": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config worker.js",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/server",
    "prod-clock": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 clock.js",
    "prod-worker": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100 worker.js",
    "client": "nodemon start-client.js",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "heroku-postbuild": "cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
