{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "body-parser": "1.20.2",
    "cron": "3.1.7",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-jwt": "8.4.1",
    "jwks-rsa": "3.1.0",
    "lodash": "4.17.21",
    "moment-timezone": "0.5.45",
    "mongoose": "^6.12.8",
    "path": "0.12.7",
    "puppeteer-core": "^22.9.0"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "nodemon": "3.1.0"
  },
  "engines": {
    "node": "20.10.0"
  },
  "scripts": {
    "debug_start_local": "concurrently \"npm run debug-local-server\" \"npm run client\"",
    "debug-local-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config src/server",
    "debug-local-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config src/workers",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/server",
    "prod-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/workers",
    "client": "nodemon start-client.js",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "npm install react-scripts && cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
