{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "body-parser": "1.20.2",
    "cron": "2.1.0",
    "dotenv": "16.0.3",
    "express": "4.18.3",
    "express-jwt": "7.7.7",
    "jwks-rsa": "2.1.5",
    "lodash": "4.17.21",
    "moment-timezone": "0.5.45",
    "mongoose": "6.5.5",
    "path": "0.12.7",
    "puppeteer": "^23.0.2"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "nodemon": "2.0.22"
  },
  "engines": {
    "node": "20.10.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/server",
    "prod-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/workers",
    "client": "nodemon start-client.js",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "npm install react-scripts && cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
