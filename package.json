{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cron": "4.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-jwt": "8.5.1",
    "jwks-rsa": "4.0.1",
    "lodash": "4.18.1",
    "moment-timezone": "0.6.2",
    "mongoose": "9.6.1",
    "path": "0.12.7",
    "puppeteer": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "nodemon": "3.1.14"
  },
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node src/server",
    "prod-worker": "node src/workers",
    "test:notification": "node --test src/server/notification/__tests__/pickReminderScheduler.test.js",
    "client": "nodemon start-client.js",
    "generate-vapid": "npx web-push generate-vapid-keys",
    "local-prod": "npm --prefix src/client run build && NODE_ENV=production node src/server",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "npm install vite && cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
