{
  "name": "me-vs-yall",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "body-parser": "1.19.1",
    "chrome-aws-lambda": "10.1.0",
    "cron": "1.8.2",
    "dotenv": "14.2.0",
    "express": "4.17.2",
    "express-jwt": "6.1.0",
    "jwks-rsa": "2.0.5",
    "lodash": "4.17.21",
    "moment-timezone": "0.5.34",
    "mongoose": "6.1.7",
    "path": "0.12.7",
    "puppeteer-core": "^13.1.1"
  },
  "devDependencies": {
    "concurrently": "7.0.0",
    "nodemon": "2.0.15"
  },
  "engines": {
    "node": "14.x"
  },
  "scripts": {
    "start_local": "concurrently \"npm run local-server\" \"npm run client\"",
    "local-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config src/server",
    "local-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 -r dotenv/config src/workers/updateGames",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server",
    "prod-server": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/server",
    "prod-worker": "node --expose-gc --inspect --optimize_for_size --max_old_space_size=460 --gc_interval=100 src/workers/updateGames",
    "client": "nodemon start-client.js",
    "dev": "echo \"This command has been deprecated. Use 'npm start'\" && exit 1",
    "heroku-postbuild": "cd src/client/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
  }
}
